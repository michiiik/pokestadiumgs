+    # A commuted source pair is not a register-allocation disagreement. Require
+    # the complete aligned byte span: same destination, opcode, shift amount
+    # and every other bit, with rs/rt exchanged at every differing word. This
+    # is diagnostic only; byte equality and the full-ROM gate remain mandatory.
+    if (
+        diff_offsets
+        and len(expected) == len(actual)
+        and len(expected) % 4 == 0
+        and actual_symbol_size in (None, len(actual))
+    ):
+        swapped = []
+        for index, (left, right) in enumerate(zip(expected_words, actual_words)):
+            if left == right:
+                continue
+            if not (
+                left >> 26 == 0
+                and left & 0x3F in (0x21, 0x2D, 0x24, 0x25, 0x26, 0x27)
+                and left & 0xFC00FFFF == right & 0xFC00FFFF
+                and (left >> 21) & 31 == (right >> 16) & 31
+                and (left >> 16) & 31 == (right >> 21) & 31
+            ):
+                break
+            swapped.append(index * 4)
+        else:
+            if swapped:
+                details["mismatch_kind"] = "commutative_operand_order_only"
+                details["operand_order_offsets"] = swapped
