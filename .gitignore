# User-provided ROMs
*.n64
*.v64
*.z64

# Decompilation outputs
disasm/build/
disasm/probes/
disasm/scratch/
generated/

# container/build.sh's staged coalesce-lui reference map (see its own
# comment) -- a host-local copy of a generated build artifact, regenerated
# fresh before every image build, never meant to be tracked.
container/.map-cache/

# Durable probe-stats history (see tools/probe_stats.py) -- deliberately
# outside disasm/build/ so a build clean cannot wipe candidate-runner history
# No trailing slash: a fleet clone replaces this with a SYMLINK to the primary
# checkout's ledger so the fleet shares one process memory, and a
# directory-only pattern would leave that symlink showing up as untracked.
disasm/probe-stats

# Android/Gradle outputs and machine-local configuration
.gradle/
android/.gradle/
android/local.properties
android/**/build/

# Native build outputs
build*/
*.apk
*.so
*.log
*.tgz
function_sizes.toml

# Local runtime and FPS screenshots
screenshots/

# IDE files
.idea/
*.iml

# Local debug/dev artifacts (screenshots, signed APKs, RAM dumps, staged APK contents)
artifacts/
$stage/

# macOS Finder metadata
.DS_Store

__pycache__/

.worktrees/

# Cloned decompilation helpers (see tools/setup_decomp_tools.sh)
disasm/tools/m2c/
disasm/tools/decomp-permuter/
disasm/tools/decomp-venv/

# per-session git worktrees created by tooling sessions
.claude/worktrees/

# Agent candidate-batch scratch files (tools/fleet_probe.py inputs and their
# results). These are per-attempt working files, not process evidence -- the
# durable record is disasm/probe-stats/ and docs/regions/. Left untracked and
# unignored they drown the `git status` check AGENTS.md 1.2 depends on to spot
# a concurrent runner transaction (361 of them on 2026-09-01).
#
# Deliberately narrow: docs/regions/*.md region notes and tools/*.py are real
# work and must keep showing up in `git status`.
*_batch*.json
*_probe.json
*_probe[0-9]*.json
*_gate*.json
*_result*.json
*_successor*.json
*_candidates/
.agents/
.agent*.json
.coord_*.json
.fleet_tmp*
.fleet*.tmp
.luna*.json
.tmp*.json
.wave*.json
tmp_*.json
tmp_scratch/
wave*_*/
probe[0-9]*.json
# Prefix forms of the same scratch files (batch_<addr>_<hypothesis>.json and the
# candidate/declaration snippets beside them). The suffix patterns above miss
# these, so a live fleet re-polluted `git status` with seven of them.
# Anchored to the repo root: unanchored, `candidate_*.c` would also swallow a
# real source under disasm/src/.
/batch_*.json
# Dot-prefixed variant of the same: an agent wrote .batch_82614BD0.json, which
# matches neither *_batch*.json (nothing precedes "batch") nor the anchored
# /batch_*.json (the leading dot).
/.batch*.json
# Permuter working files: the seed body and its declarations block, written
# beside the repo root before a permute_candidate.py run.
/.permute_*.c
/.permute_*.txt
/candidate_*.c
/decl_*.txt

# Timestamped hand backups left beside a tool during an edit
*.bak-[0-9]*

# worklist has source assembly in it
asm_worklist.html