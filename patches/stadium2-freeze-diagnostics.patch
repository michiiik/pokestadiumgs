+// Stadium 2 does not ship Stadium 1's audio microcode: its ucode text lives at
+// ROM 0x1060 and its ucode_data header (0000 0001 0002 FFFF 0020 0800 7FFF
+// 4000 ...) does not match Stadium 1's aspMain dispatch table, which appears
+// nowhere in the Stadium 2 ROM. Running Stadium 1's recompiled aspMain against
+// Stadium 2 command lists makes its handlers compute RDRAM addresses from the
+// wrong ABI and write over unrelated memory. Skipping the task leaves audio
+// silent but stops the corruption; replace with a real recompilation of the
+// Stadium 2 microcode.
+static RspExitReason aspMain_skip(uint8_t* rdram, uint32_t ucode_addr) {
+    (void)rdram;
+    (void)ucode_addr;
+    return RspExitReason::Broke;
 }
 
