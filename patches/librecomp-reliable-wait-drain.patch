         return;
     }
     external_messages.wait_dequeue(to_send);
     g_external_pending.fetch_sub(1, std::memory_order_relaxed);
-    do_send(PASS_RDRAM to_send.mq, to_send.mesg, to_send.jam, false);
+    deliver_waited_external(PASS_RDRAM to_send);
 #endif
 }
 
